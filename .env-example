# Copy this file to .env and fill in your values.
#   cp .env-example .env

# Your Google Cloud project ID (the project where Text-to-Speech / Vertex AI is enabled).
CLOUD_PROJECT_ID=your-gcp-project-id

# Path to the service-account JSON key used to authenticate.
# Create one with:
#   gcloud iam service-accounts create tts-sa --display-name="Gemini TTS"
#   gcloud projects add-iam-policy-binding YOUR_PROJECT \
#     --member="serviceAccount:tts-sa@YOUR_PROJECT.iam.gserviceaccount.com" \
#     --role="roles/aiplatform.user"
#   gcloud iam service-accounts keys create sa-key.json \
#     --iam-account=tts-sa@YOUR_PROJECT.iam.gserviceaccount.com
# The key file never expires by default. Keep it out of version control.
GOOGLE_APPLICATION_CREDENTIALS=sa-key.json
